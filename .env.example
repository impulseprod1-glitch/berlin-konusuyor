# News automation keys (scripts/fetch-news.mjs).
# Copy to .env for local runs; in GitHub Actions they are repository secrets.
# Never put real values in this file – it is public.

# NewsData.io – https://newsdata.io/register
NEWSDATA_API_KEY=

# Google Gemini – https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Firebase Admin service account JSON (push notifications from the script)
FIREBASE_SERVICE_ACCOUNT=
