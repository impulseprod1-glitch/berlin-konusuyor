# ═══════════════════════════════════════════════════════════
#  Berlin Konuşuyor — Ortam Değişkenleri
#  Bu dosyayı `.env` olarak kopyalayın. .env ASLA commit edilmez.
#  GERÇEK ANAHTARLARI BU DOSYAYA YAZMAYIN — burası şablondur.
# ═══════════════════════════════════════════════════════════

# Firebase Admin servis hesabı (JSON'un tek satırlık hali).
# Yalnızca GitHub Actions içinde secret olarak kullanılır.
# Kullanım: sitemap/RSS üretimi + push bildirim kuyruğu.
FIREBASE_SERVICE_ACCOUNT=

# Sitenin kök adresi (sitemap ve RSS bağlantıları için)
SITE_BASE_URL=https://berlinkonusuyor.com

# NOT: NEWSDATA_API_KEY ve GEMINI_API_KEY artık kullanılmıyor.
# Dış kaynaklardan haber çekme telif nedeniyle kaldırıldı (docs/ANALIZ.md).
